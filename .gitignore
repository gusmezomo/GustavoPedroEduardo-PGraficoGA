# Ignorar a pasta de build e arquivos temporários do CMake
/build/
/CMakeCache.txt
/CMakeFiles/
/Makefile
/cmake_install.cmake

# Ignorar arquivos de saída do compilador (objetos e executáveis)
*.o
#*.obj
*.exe
*.out
*.a
*.lib
*.dll
*.so

# Ignorar dependências baixadas automaticamente pelo CMake (GLFW FetchContent)
_build/
_deps/
glfw-src/
glfw-build/

# Ignora diretórios com dependências externas baixadas automaticamente pelo FetchContent (stb_image CMake)
external/


# Ignorar configurações específicas do VSCode
CMakeUserPresets.json

# Ignorar logs e arquivos de sistema
*.log
.DS_Store
Thumbs.db

#Aceitar Dlls necessarias
!dlls/libgcc_s_seh-1.dll
!dlls/libstdc++-6.dll
!dlls/libwinpthread-1.dll

#Comando para rodar no Linux Hyprland
run.txt


